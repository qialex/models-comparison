# PrismML llama.cpp fork: required for ternary GGUF Q2_0 (not in upstream CUDA yet).
# Pre-built Linux CUDA 12.4 binaries: https://github.com/PrismML-Eng/llama.cpp/releases
FROM ghcr.io/ggml-org/llama.cpp:server-cuda

USER root
ARG PRISM_TAG=prism-b9596-9fcaed7
ARG PRISM_ASSET=llama-prism-b9596-9fcaed7-bin-linux-cuda-12.4-x64.tar.gz

RUN curl -fL -o /tmp/prism.tgz \
      "https://github.com/PrismML-Eng/llama.cpp/releases/download/${PRISM_TAG}/${PRISM_ASSET}" \
    && mkdir -p /tmp/prism \
    && tar -xzf /tmp/prism.tgz -C /tmp/prism \
    && SERVER="$(find /tmp/prism -type f -name llama-server | head -n1)" \
    && test -n "${SERVER}" \
    && DIR="$(dirname "${SERVER}")" \
    && cp -a "${DIR}/." /app/ \
    && chmod +x /app/llama-server \
    && rm -rf /tmp/prism /tmp/prism.tgz

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV MODEL_DIR=/models \
    N_CTX=2048 \
    N_THREADS=4 \
    N_PREDICT=256 \
    N_PARALLEL=1 \
    N_GPU_LAYERS=99 \
    HOST=0.0.0.0 \
    LD_LIBRARY_PATH=/app

VOLUME ["/models"]
EXPOSE 8104 8105 8106 8108

ENTRYPOINT ["/entrypoint.sh"]
