# Optional Hugging Face token if downloads are rate-limited
HF_TOKEN=

# Context length (emotional-score prompt alone is ~740 tokens)
N_CTX=2048

# CPU threads for llama.cpp (per container)
N_THREADS=4

# Default max tokens per completion
N_PREDICT=256

# Keep 1 so full -c is available to a single request
N_PARALLEL=1

# GPU services only (bonsai8_gpu, qwen35_*_gpu, bonsai27_gpu, ternary_bonsai*_gpu). 0 = CPU; 99 = offload all layers
N_GPU_LAYERS=99

# Qwen3-0.6B only (qwen35 forces off in compose)
# auto | on | off
REASONING=auto
